# Optional settings for the legacy backend /api/nodes/{gid}/explain endpoint.
# The browser assistant uses an OpenAI API key entered in the interface;
# it does not read these variables. The primary pipeline needs no AI key.
# Supply these as server environment variables or through Compose --env-file.
# Python itself does not automatically load .env.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
